// Physical constraints -- Tang Nano 20K (GW2AR-LV18QN88C8/I7)
// Pin assignments confirmed in the uart_echo bring-up.

IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// UART bridged to USB by the onboard BL616 -- no extra wiring.
IO_LOC  "uart_txd" 69;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33;

IO_LOC  "uart_rxd" 70;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33;

// LEDs are active low on this board.
IO_LOC  "led0" 15;
IO_PORT "led0" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "led1" 16;
IO_PORT "led1" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
